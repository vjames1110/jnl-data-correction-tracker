DJANGO_ENV=development

DJANGO_SECRET_KEY=replace-me-with-a-long-random-secret-key
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

USE_REMOTE_DATABASE=False
DATABASE_URL=sqlite:///db.sqlite3

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

APP_FRONTEND_BASE_URL=http://127.0.0.1:5173
NOTIFICATION_EMAILS_ENABLED=False
NOTIFICATION_EMAIL_TIMEOUT_SECONDS=10
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_EMAIL=correctionjnl@gmail.com
BREVO_SENDER_NAME=JNLOps

# Uploaded files (attachments, profile photos).
# Leave ALL of the R2_* lines empty to keep saving uploads on this
# machine's disk (backend/media) - fine for local development.
# To store them in Cloudflare R2 instead, fill in the four required
# values below (never commit real keys; see
# docs/deployment/cloudflare-r2.md). Check with:
#   python manage.py check_storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Only for a bucket created with an EU jurisdiction, e.g.
# https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Optional folder inside the bucket, e.g. "prod" to keep production
# and staging files apart in one bucket.
R2_KEY_PREFIX=
R2_SIGNED_URL_SECONDS=3600
